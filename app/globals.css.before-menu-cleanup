@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');
@import "tailwindcss";

:root {
  --ink: #0b0b0a;
  --paper: #eee9df;
  --gold: #c9b38d;
  --line: #2b2a26;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 85px; }
body {
  margin: 0;
  background: var(--ink);
  color: #f1eee7;
  font-family: 'DM Sans', sans-serif;
}
button, a { font: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }

.announcement {
  height: 28px;
  background: #c8b38f;
  color: #171511;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.7px;
}

.site-header {
  height: 82px;
  padding: 0 6.5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #292824;
  background: #0b0b0a;
  position: sticky;
  top: 0;
  z-index: 30;
}

.wordmark { display: flex; align-items: center; gap: 10px; }
.wordmark span {
  font: 600 31px 'Playfair Display', serif;
  letter-spacing: -2px;
}
.wordmark i {
  font-style: normal;
  font-size: 7px;
  letter-spacing: 2px;
  color: #a6a095;
  border-left: 1px solid #514b40;
  padding-left: 10px;
}
.main-nav { display: flex; gap: 35px; }
.main-nav a, .header-order, .bag-trigger {
  font-size: 8px;
  letter-spacing: 1.5px;
}
.main-nav a { color: #c3beb4; transition: color .2s; }
.main-nav a:hover { color: var(--gold); }
.header-actions { display: flex; align-items: center; gap: 24px; }
.header-order {
  border: 1px solid #bba782;
  background: transparent;
  color: #e8ddc9;
  padding: 13px 17px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.bag-trigger {
  display: flex;
  align-items: center;
  gap: 8px;
  background: none;
  color: #eee;
}
.bag-trigger b {
  width: 19px;
  height: 19px;
  border: 1px solid #777;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 9px;
}
.mobile-menu { display: none; background: none; color: white; }

.hero {
  min-height: 690px;
  padding: 86px 6.5% 90px;
  display: grid;
  grid-template-columns: .94fr 1.06fr;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.hero-backdrop-word {
  position: absolute;
  right: -15px;
  top: 35px;
  font: 700 220px 'Playfair Display', serif;
  color: #ffffff06;
  pointer-events: none;
}
.hero-copy { position: relative; z-index: 2; padding-bottom: 22px; }
.eyebrow {
  font-size: 8px;
  letter-spacing: 2px;
  color: #b9a681;
  margin: 0 0 27px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.eyebrow-line { width: 24px; height: 1px; background: #b9a681; }

.hero h1, .story-content h2, .section-title-row h2,
.special-copy h2, .gallery-heading h2, .visit-heading h2 {
  font: 500 clamp(66px, 7.6vw, 108px)/.91 'Playfair Display', serif;
  letter-spacing: -4px;
  margin: 0;
}
.hero h1 em, .story-content h2 em, .section-title-row h2 em,
.special-copy h2 em, .gallery-heading h2 em, .visit-heading h2 em {
  color: var(--gold);
  font-weight: 500;
}
.hero-lede {
  max-width: 360px;
  color: #aaa69c;
  font-size: 13px;
  line-height: 1.9;
  margin: 29px 0;
}
.hero-ctas { display: flex; align-items: center; gap: 27px; }
.btn-cream, .btn-dark {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 17px;
  padding: 16px 20px;
  background: var(--paper);
  color: #171612;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.2px;
  border: 0;
}
.understated-link, .dark-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 8px;
  letter-spacing: 1.4px;
  color: #d6c9b0;
}
.hero-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 92px;
  color: #77736a;
  font-size: 7px;
  letter-spacing: 1.6px;
}
.hero-meta i { height: 1px; width: 45px; background: #777; }

.hero-art { height: 490px; position: relative; margin-left: 20px; }
.hero-main-image {
  position: absolute;
  inset: 0 8% 22px 8%;
  background: url('https://images.unsplash.com/photo-1601050690597-df0568f70950?auto=format&fit=crop&w=1400&q=90') center/cover;
  filter: brightness(.77);
}
.hero-small-image {
  position: absolute;
  width: 37%;
  height: 39%;
  bottom: 0;
  left: 0;
  border: 8px solid var(--ink);
  background: url('https://images.unsplash.com/photo-1668236543090-82eba5ee5976?auto=format&fit=crop&w=700&q=85') center/cover;
}
.hero-image-label {
  position: absolute;
  bottom: 0;
  right: 8%;
  left: 48%;
  display: flex;
  justify-content: space-between;
  font-size: 7px;
  letter-spacing: 1.2px;
  color: #a7a196;
}
.seal {
  position: absolute;
  right: 0;
  top: 35px;
  width: 91px;
  height: 91px;
  border: 1px solid #c7b18b;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #d5c19c;
  font: 12px 'Playfair Display', serif;
  line-height: 1.05;
  transform: rotate(9deg);
  background: #0b0b0a;
}
.seal b { font-size: 9px; font-weight: 500; letter-spacing: 2px; }
.seal i { font-style: normal; font-size: 13px; margin-top: 3px; }
.scroll-cue {
  position: absolute;
  left: 6.5%;
  bottom: 25px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #777;
  font-size: 7px;
  letter-spacing: 1.7px;
}

.story-section {
  background: var(--paper);
  color: #171612;
  padding: 88px 10% 100px;
}
.story-top, .section-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dark-eyebrow { color: #776c59; }
.story-index, .section-note {
  font-size: 7px;
  letter-spacing: 1.5px;
  color: #847a69;
}
.story-content {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: end;
  gap: 9%;
  margin-top: 62px;
}
.story-content h2 {
  font-size: clamp(57px, 6.5vw, 88px);
  letter-spacing: -3px;
}
.story-content h2 em { color: #927c59; }
.story-right p {
  font-size: 13px;
  line-height: 2;
  color: #69645b;
  margin: 0 0 26px;
}
.dark-link {
  color: #2a261f;
  border-bottom: 1px solid #a99b82;
  padding-bottom: 8px;
}

.menu-section { padding: 112px 6.5% 120px; }
.section-title-row, .gallery-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin: 27px 0 55px;
}
.section-title-row h2, .gallery-heading h2 {
  font-size: clamp(58px, 6.5vw, 88px);
  letter-spacing: -3px;
}
.section-title-row p, .gallery-heading p {
  font-size: 11px;
  line-height: 1.9;
  color: #99958b;
  margin: 0 8% 7px 0;
}
.menu-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--line);
  margin-bottom: 28px;
}
.category-list { display: flex; gap: 10px; overflow-x: auto; }
.category-pill {
  background: transparent;
  color: #918d83;
  padding: 10px 16px 14px;
  border: 0;
  border-bottom: 1px solid transparent;
  font-size: 9px;
  white-space: nowrap;
}
.category-pill.selected { color: #f0e8d8; border-color: #c7b18b; }
.item-count { font-size: 7px; letter-spacing: 1.5px; color: #777; padding-bottom: 13px; }
.dish-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 42px 22px;
}
.dish-card { min-width: 0; }
.dish-image-wrap {
  height: 275px;
  position: relative;
  overflow: hidden;
  background: #171613;
}
.dish-image {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform .6s, filter .4s;
  filter: brightness(.82);
}
.dish-card:hover .dish-image { transform: scale(1.055); filter: brightness(1); }
.dish-tag {
  position: absolute;
  top: 13px;
  left: 13px;
  background: #e9e2d6;
  color: #171612;
  padding: 8px 10px;
  font-size: 7px;
  letter-spacing: 1.3px;
}
.add-round {
  position: absolute;
  right: 13px;
  bottom: 13px;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: #eee8dc;
  color: #171612;
  display: grid;
  place-items: center;
  transition: transform .2s, background .2s;
}
.add-round:hover { transform: rotate(90deg); background: #c9b38d; }
.dish-details { padding: 17px 1px 0; }
.dish-category {
  font-size: 7px;
  letter-spacing: 1.7px;
  text-transform: uppercase;
  color: #b9a47d;
}
.dish-details h3 { font: 500 23px 'Playfair Display', serif; margin: 6px 0; }
.dish-details p { font-size: 10px; line-height: 1.8; color: #8f8b82; margin: 0; min-height: 36px; }
.dish-buy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding-top: 13px;
  margin-top: 17px;
}
.dish-buy strong { font-size: 13px; }
.dish-buy button {
  display: flex;
  align-items: center;
  gap: 7px;
  background: none;
  border: 0;
  color: #c9b38d;
  font-size: 7px;
  letter-spacing: 1.3px;
}
.demo-note {
  font-size: 7px;
  letter-spacing: 1.2px;
  color: #706d65;
  margin-top: 48px;
  line-height: 1.7;
}

.special-section {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  background: #171613;
  min-height: 600px;
}
.special-image {
  position: relative;
  min-height: 600px;
  background: url('https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1400&q=90') center/cover;
  filter: brightness(.72);
}
.vertical-note {
  position: absolute;
  left: 25px;
  bottom: 25px;
  writing-mode: vertical-rl;
  font-size: 7px;
  letter-spacing: 2px;
  color: #eee;
}
.special-copy {
  padding: 85px 12%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.special-copy h2 {
  font-size: clamp(65px, 7vw, 95px);
  letter-spacing: -3px;
}
.special-copy>p {
  max-width: 300px;
  color: #a39f95;
  font-size: 12px;
  line-height: 1.9;
  margin: 26px 0;
}
.special-foot { font-size: 7px; letter-spacing: 1.2px; color: #777; margin-top: 27px; }

.gallery-section { padding: 115px 6.5% 130px; }
.gallery-heading { margin-bottom: 45px; }
.gallery-layout {
  height: 390px;
  display: grid;
  grid-template-columns: 1.1fr .82fr 1.1fr;
  gap: 14px;
}
.gallery-photo { background-size: cover; background-position: center; filter: brightness(.8); }
.gp-one { background-image: url('https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1000&q=90'); }
.gp-two {
  background-image: url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=90');
  margin-top: 42px;
}
.gp-three { background-image: url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1000&q=90'); }

.visit-section {
  background: var(--paper);
  color: #171612;
  padding: 100px 8%;
  display: grid;
  grid-template-columns: 1.15fr 1fr 1fr;
  gap: 45px;
  align-items: center;
}
.visit-heading h2 { font-size: clamp(56px, 5.7vw, 77px); letter-spacing: -3px; }
.visit-heading h2 em { color: #927c59; }
.visit-block { display: flex; flex-direction: column; align-items: flex-start; }
.visit-block>span { font-size: 7px; letter-spacing: 1.7px; color: #8b7d65; }
.visit-block h3 { font: 500 21px 'Playfair Display', serif; margin: 12px 0 5px; }
.visit-block p { font-size: 10px; color: #716b61; line-height: 1.8; margin: 0; }
.visit-block a {
  display: flex;
  gap: 8px;
  align-items: center;
  border-bottom: 1px solid #a89a80;
  padding-bottom: 7px;
  margin-top: 21px;
  font-size: 7px;
  letter-spacing: 1.2px;
}

.footer {
  padding: 43px 6.5%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}
.footer>p, .footer>small { font-size: 7px; letter-spacing: 1.4px; color: #777; }
.footer>div { display: flex; align-items: center; gap: 22px; }
.footer>div a { color: #aaa; font-size: 8px; }
.footer-mark span { font-size: 27px; }

/* Cart and checkout */
.scrim {
  position: fixed;
  inset: 0;
  background: #000b;
  z-index: 60;
  display: flex;
  justify-content: flex-end;
}
.cart-panel {
  width: min(480px, 100%);
  height: 100%;
  background: var(--paper);
  color: #171612;
  padding: 32px;
  display: flex;
  flex-direction: column;
}
.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 1px solid #d0c8ba;
  padding-bottom: 22px;
}
.panel-heading .eyebrow { margin-bottom: 10px; }
.panel-heading h2 { font: 500 37px 'Playfair Display', serif; margin: 0; }
.panel-heading h2 em { color: #927c59; }
.close-btn { background: none; color: #171612; padding: 7px; border: 0; }
.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  color: #756e62;
}
.empty-state h3, .success-message h3 {
  font: 500 25px 'Playfair Display', serif;
  color: #171612;
  margin: 18px 0 5px;
}
.empty-state p, .success-message p { font-size: 11px; line-height: 1.8; }
.btn-dark { background: #171612; color: #f4eee2; border: 0; }
.cart-list { overflow: auto; flex: 1; }
.cart-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 18px 0;
  border-bottom: 1px solid #d0c8ba;
}
.cart-thumb {
  width: 73px;
  height: 73px;
  background-size: cover;
  background-position: center;
  flex-shrink: 0;
}
.cart-item-copy { flex: 1; }
.cart-item-copy h3 { font: 500 17px 'Playfair Display', serif; margin: 0 0 4px; }
.cart-item-copy>span { font-size: 11px; color: #777064; }
.cart-row>strong { font-size: 12px; }
.quantity { display: flex; align-items: center; gap: 11px; margin-top: 8px; }
.quantity button {
  width: 23px;
  height: 23px;
  background: #ddd5c7;
  color: #171612;
  border: 0;
  display: grid;
  place-items: center;
}
.quantity b { font-size: 10px; }
.cart-summary { padding-top: 20px; }
.cart-summary>div, .total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.cart-summary>div span, .total-row span {
  font-size: 8px;
  letter-spacing: 1.4px;
  color: #7b715f;
}
.cart-summary>div b { font: 500 24px 'Playfair Display', serif; }
.cart-summary p { font-size: 9px; color: #81796d; line-height: 1.7; margin: 10px 0 18px; }
.wide { width: 100%; }
.centered { justify-content: center; align-items: center; padding: 16px; }
.checkout-panel {
  width: min(590px, 100%);
  max-height: 92vh;
  overflow: auto;
  background: var(--paper);
  color: #171612;
  padding: 30px;
}
.checkout-fields { display: flex; flex-direction: column; gap: 15px; padding-top: 21px; }
.checkout-fields label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 7px;
  letter-spacing: 1.3px;
  color: #716958;
}
.checkout-fields input, .checkout-fields textarea {
  border: 1px solid #d0c8ba;
  background: #f8f5ef;
  color: #171612;
  padding: 13px;
  font: 11px 'DM Sans', sans-serif;
  outline: none;
  resize: vertical;
}
.checkout-fields input:focus, .checkout-fields textarea:focus { border-color: #927c59; }
.two-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.cod-box {
  border: 1px solid #d0c8ba;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.cod-box span { font-size: 7px; letter-spacing: 1.4px; color: #7c725f; }
.cod-box b { font-size: 12px; }
.cod-box small { font-size: 9px; color: #81796d; }
.total-row { border-top: 1px solid #d0c8ba; padding-top: 15px; }
.total-row b { font: 500 24px 'Playfair Display', serif; }
.checkout-fields>.demo-note { text-align: center; margin: 0; }
.success-message {
  padding: 55px 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.success-message p { max-width: 350px; color: #756e62; }

@media(max-width:900px) {
  .site-header { padding: 0 4%; }
  .main-nav { gap: 17px; }
  .hero { padding-left: 5%; padding-right: 5%; }
  .hero h1 { font-size: 78px; }
  .hero-art { height: 420px; }
  .story-section { padding-left: 7%; padding-right: 7%; }
  .menu-section, .gallery-section { padding-left: 5%; padding-right: 5%; }
  .dish-image-wrap { height: 230px; }
  .visit-section { padding: 75px 5%; gap: 25px; }
}

@media(max-width:650px) {
  .announcement { font-size: 6px; letter-spacing: 1px; }
  .site-header { height: 70px; padding: 0 5%; }
  .wordmark span { font-size: 27px; }
  .wordmark i { font-size: 6px; }
  .main-nav {
    display: none;
    position: absolute;
    top: 69px;
    left: 0;
    right: 0;
    background: #10100e;
    padding: 23px 7%;
    flex-direction: column;
    border-bottom: 1px solid #333;
  }
  .main-nav.nav-visible { display: flex; }
  .header-actions { gap: 13px; }
  .header-order { display: none; }
  .mobile-menu { display: block; border: 0; }
  .hero { display: flex; flex-direction: column; align-items: stretch; padding: 62px 6% 78px; }
  .hero h1 { font-size: 73px; }
  .hero-backdrop-word { font-size: 120px; top: 45px; }
  .hero-art { height: 330px; margin: 48px 0 0 10px; }
  .hero-main-image { inset: 0 5% 18px 7%; }
  .hero-small-image { width: 37%; height: 38%; }
  .hero-meta { margin-top: 52px; }
  .seal { width: 73px; height: 73px; font-size: 10px; }
  .story-section { padding: 70px 7%; }
  .story-top { align-items: flex-start; gap: 15px; }
  .story-index { font-size: 6px; text-align: right; }
  .story-content { display: block; margin-top: 43px; }
  .story-content h2 { font-size: 57px; }
  .story-right { margin-top: 25px; }
  .menu-section, .gallery-section { padding: 75px 6%; }
  .section-title-row, .gallery-heading { display: block; margin: 24px 0 37px; }
  .section-title-row h2, .gallery-heading h2 { font-size: 58px; }
  .section-title-row p, .gallery-heading p { margin-top: 18px; }
  .category-list { gap: 0; }
  .category-pill { padding: 10px 12px 13px; }
  .dish-grid { grid-template-columns: 1fr 1fr; gap: 27px 12px; }
  .dish-image-wrap { height: 185px; }
  .dish-details h3 { font-size: 18px; }
  .dish-details p { font-size: 9px; min-height: 52px; }
  .dish-buy button { font-size: 6px; gap: 3px; }
  .special-section { grid-template-columns: 1fr; }
  .special-image { min-height: 310px; }
  .special-copy { padding: 65px 8%; }
  .special-copy h2 { font-size: 70px; }
  .gallery-layout { height: auto; grid-template-columns: 1fr 1fr; gap: 10px; }
  .gallery-photo { height: 205px; }
  .gp-two { margin-top: 25px; }
  .gp-three { grid-column: 1/-1; height: 220px; }
  .visit-section { grid-template-columns: 1fr; padding: 72px 8%; gap: 34px; }
  .visit-heading h2 { font-size: 64px; }
  .footer { padding: 38px 7%; align-items: flex-start; flex-direction: column; }
  .footer>div { gap: 17px; }
  .cart-panel { padding: 25px 20px; }
  .checkout-panel { padding: 24px 18px; }
  .two-fields { grid-template-columns: 1fr; }
  .panel-heading h2 { font-size: 32px; }
}

/* ==========================================
   SRI GAYATRI VILAS - AUTHENTIC MENU VISUALS
