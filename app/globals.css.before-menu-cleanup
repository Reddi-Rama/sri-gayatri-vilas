/* =========================================
   CONTINUOUS FOOD IMAGE MARQUEE
========================================= */

.food-marquee-section {
  padding: 90px 0 100px;
  overflow: hidden;
  background: #090806;
  color: #f5f0e7;
}

.food-marquee-heading {
  max-width: 1440px;
  margin: 0 auto 42px;
  padding: 0 7%;
}

.food-marquee-heading h2 {
  margin-top: 16px;
  font-size: clamp(2.5rem, 5vw, 5rem);
  line-height: 1;
  letter-spacing: -0.055em;
}

.food-marquee-heading h2 em {
  font-family: Georgia, serif;
  font-weight: 400;
}

.food-marquee-window {
  width: 100%;
  overflow: hidden;
}

.food-marquee-track {
  display: flex;
  width: max-content;
  animation: food-marquee-scroll 110s linear infinite;
  will-change: transform;
}

.food-marquee-group {
  display: flex;
  flex: 0 0 auto;
  gap: 28px;
  padding-right: 28px;
}

.food-marquee-card {
  flex: 0 0 clamp(260px, 28vw, 340px);
  overflow: hidden;
  background: #000;
}

.food-marquee-card img {
  display: block;
  width: 100%;
  height: clamp(350px, 42vw, 535px);
  object-fit: cover;
  transition: transform 0.7s ease;
}

.food-marquee-card:hover img {
  transform: scale(1.035);
}

.food-marquee-caption {
  min-height: 100px;
  padding: 20px 4px;
}

.food-marquee-caption h3 {
  font-size: 19px;
  font-weight: 500;
  line-height: 1.35;
}

.food-marquee-caption span {
  display: block;
  margin-top: 12px;
  color: #b9a88e;
  font-size: 11px;
  letter-spacing: 0.12em;
}

@keyframes food-marquee-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.food-marquee-section:hover .food-marquee-track {
  animation-play-state: paused;
}

@media (max-width: 600px) {
  .food-marquee-section {
    padding: 65px 0 70px;
  }

  .food-marquee-heading {
    margin-bottom: 28px;
  }

  .food-marquee-group {
    gap: 16px;
    padding-right: 16px;
  }

  .food-marquee-card {
    flex-basis: 76vw;
  }

  .food-marquee-card img {
    height: 390px;
  }

  .food-marquee-caption h3 {
    font-size: 17px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .food-marquee-track {
    animation: none;
  }
}

/* FOOD CAROUSEL CONTROLS */

.food-marquee-track.reverse {
  animation-direction: reverse;
}

.food-marquee-controls {
  max-width: 1440px;
  margin: 28px auto 0;
  padding: 0 7%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
}

.marquee-play-button,
.marquee-arrow-button {
  height: 46px;
  min-width: 46px;
  padding: 0 17px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  border: 1px solid rgba(245, 240, 231, 0.28);
  background: transparent;
  color: #f5f0e7;
  cursor: pointer;
  transition: background 0.25s ease, color 0.25s ease;
}

.marquee-play-button {
  min-width: 74px;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.marquee-arrow-button {
  font-size: 19px;
}

.marquee-play-button:hover,
.marquee-arrow-button:hover {
  background: #f5f0e7;
  color: #090806;
}

@media (max-width: 600px) {
  .food-marquee-controls {
    padding: 0 6%;
  }
}
