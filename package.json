{
    "name": "sri-gayatri-vilas",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "desktop": "electron desktop/main.cjs",
        "dist:win": "electron-builder --win nsis",
        "cf:build": "opennextjs-cloudflare build",
        "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "cf:upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.119.1",
        "firebase": "^13.4.0",
        "firebase-admin": "^14.5.1",
        "framer-motion": "^14.14.0",
        "lucide-react": "^1.75.0",
        "next": "16.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "1.20.18",
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "electron": "^45.4.1",
        "electron-builder": "^26.18.0",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "tailwindcss": "4.3.3",
        "typescript": "^5",
        "wrangler": "4.166.0"
    },
    "main": "desktop/main.cjs",
    "build": {
        "appId": "com.srigayatrivilas.desktop",
        "productName": "Sri Gayatri Vilas",
        "directories": {
            "output": "release"
        },
        "files": [
            "desktop/**/*",
            "package.json",
            "!desktop/main.backup.cjs"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "allowToChangeInstallationDirectory": true
        }
    }
}
